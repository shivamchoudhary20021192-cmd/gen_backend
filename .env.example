# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# The admin frontend's prefix. /admin/api/<version> (e.g. /admin/api/2026-10)
# is always served; v1 is an alias of the first dated version.
API_PREFIX=/admin/api/v1
# Admin frontends. Storefronts on shop domains are allowed automatically.
CORS_ORIGINS=http://localhost:3000

# ── Platform ─────────────────────────────────────────────────────────────────
PLATFORM_NAME=Veylog
# Every shop gets <handle>.<this> as its platform domain.
PLATFORM_STOREFRONT_DOMAIN=myveylog.com
# Where the admin app runs: links in staff emails, and who may frame the theme
# editor's preview (outside production any localhost port may, too).
PLATFORM_ADMIN_URL=http://localhost:3000
# The API's public origin — where providers send webhooks and status callbacks.
PUBLIC_API_URL=http://localhost:4000
# Custom domains point a CNAME here (or A records at PLATFORM_EDGE_IPS).
# PLATFORM_EDGE_HOSTNAME=shops.myveylog.com
# PLATFORM_EDGE_IPS=203.0.113.10,203.0.113.11
PLATFORM_SIGNUP_ENABLED=true
# Single-shop compatibility: storefront requests on a host no shop owns are
# served by this shop (its handle). Leave empty on a multi-shop platform.
DEFAULT_SHOP=
# The founding shop's storefront URL (used for its links; also registered as
# its custom domain by migration 101).
STOREFRONT_URL=http://localhost:5174

# App API rate-limit buckets: database (shared by every API node) or memory (per process).
# APP_RATE_LIMIT_STORE=database

# ── Platform email (invitations, password resets, billing notices) ───────────
# log (development default: nothing is sent; read messages with
# GET /platform/api/v1/emails), postmark, or sendgrid with the platform's own key.
# PLATFORM_EMAIL_PROVIDER=log
# PLATFORM_EMAIL_API_KEY=
# PLATFORM_EMAIL_FROM=no-reply@myveylog.com
# PLATFORM_EMAIL_FROM_NAME=Veylog

# ── Platform billing (the platform charging its merchants) ───────────────────
# simulator (development default: test cards sim_card_visa / sim_card_declined),
# stripe (the platform's own Stripe account), or manual (bills marked paid by
# an operator; the production default until a processor is configured).
# PLATFORM_BILLING_PROVIDER=simulator
# PLATFORM_STRIPE_SECRET_KEY=
# PLATFORM_STRIPE_PUBLISHABLE_KEY=
# Days an unpaid bill is tolerated after its first failed charge before the store is frozen.
# BILLING_GRACE_DAYS=7

# ── Tenancy ──────────────────────────────────────────────────────────────────
# enforce: a query on a shop's tables that is not scoped to the current shop
# throws. warn: logs it. off: never in production.
TENANT_GUARD=enforce
# Extra pods: id=mysql://user:pass@host:3306/db, comma separated. Pod 1 is DB_*.
# PODS=2=mysql://veylog:secret@pod2.internal:3306/veylog

# ── Background work ──────────────────────────────────────────────────────────
# true: jobs, schedules and event dispatch run inside the API (one server).
# false: run `npm run worker` (or the `worker` compose service) separately.
WORKER_EMBEDDED=true
WORKER_CONCURRENCY=8
WORKER_POLL_MS=1000
# Worker health and metrics listener (0 = off).
WORKER_PORT=0
MESSAGING_WORKER=on

# ── The platform's own bills: tax and processor events ───────────────────────
# Where the platform is registered for tax; empty = no tax on its bills.
# PLATFORM_TAX_COUNTRY=IN
# PLATFORM_TAX_REGION=KA
# PLATFORM_TAX_RATE=18
# PLATFORM_TAX_NAME=GST
# PLATFORM_TAX_ID=
# The platform Stripe account's webhook signing secret (whsec_…), for
# POST /platform/api/v1/billing/webhooks/stripe.
# PLATFORM_STRIPE_WEBHOOK_SECRET=

# ── Storefront page cache ────────────────────────────────────────────────────
# Anonymous storefront pages are cached per API process under each shop's
# content version (bumped by any change to the shop), and at the edge by the
# edge worker. 0 MB turns caching off everywhere.
# PAGE_CACHE_MAX_MB=64
# PAGE_CACHE_TTL_SECONDS=300
# How often each process asks which shops changed, and the least time between
# two version bumps of one shop.
# STOREFRONT_VERSION_POLL_MS=2000
# STOREFRONT_VERSION_BUMP_MS=2000

# ── Custom domains and the edge (docs/DOMAINS.md) ────────────────────────────
# cloudflare (Cloudflare for SaaS), on_demand (Caddy fleet), local (development).
# EDGE_PROVIDER=local
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# The edge's key to /internal/edge/* (tls-allowed, route).
# EDGE_SHARED_SECRET=
# PLATFORM_EDGE_TARGET_ZONE=shops.myveylog.com
# EDGE_CERTIFICATE_AUTHORITIES=letsencrypt.org,pki.goog
# DNS lookups: cloudflare,google (DNS over HTTPS), system, static, or DoH URLs.
# DNS_RESOLVERS=cloudflare,google
# DNS_STATIC_FILE=            # development/test: a JSON zone file
# PUBLIC_SUFFIX_FILE=         # the full Public Suffix List (a built-in subset otherwise)
# Selling domains: sandbox, or namecom with NAMECOM_USERNAME / NAMECOM_TOKEN.
# REGISTRAR=sandbox
# REGISTRAR_MARKUP_PERCENT=0
# DOMAIN_SWEEP_BATCH=200
# DOMAIN_SWEEP_CONCURRENCY=10

# ── Security ─────────────────────────────────────────────────────────────────
# Keys that seal integration credentials and app secrets at rest (AES-256-GCM).
# Generate: node -e "console.log('v1:'+require('crypto').randomBytes(32).toString('base64'))"
# Rotate by adding v2 and setting VAULT_ACTIVE_KEY=v2; keep v1 until resealed.
VAULT_KEYS=
VAULT_ACTIVE_KEY=
# Prometheus scrape token for /metrics. Without it /metrics is off in production.
METRICS_TOKEN=
# Outbound webhooks to private addresses (local development only).
WEBHOOKS_ALLOW_PRIVATE_TARGETS=false
WEBHOOKS_TIMEOUT_MS=5000

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=veylog
DB_CONNECTION_LIMIT=10

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-64-byte-random-hex-string
JWT_ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
# Pepper mixed into token hashes. Rotating it invalidates all sessions.
TOKEN_PEPPER=change-me-too

# ── Media storage ────────────────────────────────────────────────────────────
# local | s3 (any S3-compatible store: AWS, R2, MinIO, Spaces).
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   (omit for AWS)
# S3_PUBLIC_BASE_URL=https://cdn.example.com                (the CDN in front)
STORAGE_LOCAL_ROOT=./storage/media
STORAGE_LOCAL_BASE_URL=/media
MEDIA_MAX_UPLOAD_MB=25
MEDIA_MAX_FILES_PER_REQUEST=20

# ── Legacy single-shop payment keys ──────────────────────────────────────────
# Apply to the founding shop only (LEGACY_PAYMENT_ENV_SHOP_ID, default 1).
# Every other shop connects its own gateway under Settings → Integrations.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# LEGACY_PAYMENT_ENV_SHOP_ID=1

# ── Platform administrator bootstrap (npm run db:seed) ───────────────────────
SUPERADMIN_EMAIL=admin@veylor.com
SUPERADMIN_PASSWORD=ChangeMe!2026
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Admin
# Also make the administrator a member of this store (defaults to the first).
# SEED_SHOP=
