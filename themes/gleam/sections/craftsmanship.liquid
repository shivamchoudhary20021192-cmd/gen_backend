{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) { .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
{%- endstyle -%}
<div class="craft scheme-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="section-heading section-heading--center" data-reveal>
      {%- if section.settings.caption != blank -%}<p class="eyebrow">{{ section.settings.caption | escape }}</p>{%- endif -%}
      <h2 class="section-heading__title h0">{{ section.settings.heading | escape }}</h2>
    </div>
    <ol class="craft__steps">
      {%- for block in section.blocks -%}
        <li class="craft__step{% cycle '', ' craft__step--reverse' %}" {{ block.shopify_attributes }} data-reveal>
          <div class="craft__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '375, 750, 1000, 1200', alt: block.settings.title }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="craft__text">
            <span class="craft__number">{{ forloop.index | prepend: '0' }}</span>
            <h3 class="h1">{{ block.settings.title | escape }}</h3>
            <div class="rte">{{ block.settings.text }}</div>
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

{% schema %}
{
  "name": "Craftsmanship",
  "tag": "section",
  "class": "section section-craft",
  "max_blocks": 5,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "caption", "label": "Caption", "default": "Made by hand" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From sketch to setting" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "background", "label": "Background" },
        { "value": "surface", "label": "Surface" },
        { "value": "surface-alt", "label": "Surface alternate" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "background"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Designed" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every piece starts as a drawing in our studio.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Craftsmanship",
      "category": "Story",
      "blocks": [
        { "type": "step", "settings": { "title": "Designed", "text": "<p>Every piece starts as a drawing in our studio.</p>" } },
        { "type": "step", "settings": { "title": "Cast and set", "text": "<p>Recycled gold, cast in small batches and set by hand.</p>" } },
        { "type": "step", "settings": { "title": "Finished", "text": "<p>Polished, hallmarked and checked twice before it ships.</p>" } }
      ]
    }
  ]
}
{% endschema %}
