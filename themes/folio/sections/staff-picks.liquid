{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) { .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
{%- endstyle -%}
<div class="staff-picks scheme-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="section-heading section-heading--left" data-reveal>
      <h2 class="section-heading__title h1">{{ section.settings.heading | escape }}</h2>
    </div>
    <ul class="staff-picks__grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign pick = block.settings.product -%}
        <li class="staff-pick" {{ block.shopify_attributes }} data-reveal>
          <a class="staff-pick__cover" href="{{ pick.url | default: '#' }}">
            {%- if pick.featured_image -%}{{ pick.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: pick.title }}{%- else -%}{{ 'product-6' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
          </a>
          <div class="staff-pick__body">
            <p class="staff-pick__note">“{{ block.settings.note | escape }}”</p>
            <p class="staff-pick__who">— {{ block.settings.staff_name | escape }}</p>
            <h3 class="staff-pick__title"><a href="{{ pick.url | default: '#' }}">{{ pick.title | default: 'Book title' | escape }}</a></h3>
            {%- if pick != blank -%}{% render 'price', product: pick %}{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Staff picks",
  "tag": "section",
  "class": "section section-staff-picks",
  "max_blocks": 6,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Staff picks" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "background", "label": "Background" },
        { "value": "surface", "label": "Surface" },
        { "value": "surface-alt", "label": "Surface alternate" }
      ],
      "default": "background"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "pick",
      "name": "Pick",
      "settings": [
        { "type": "product", "id": "product", "label": "Book" },
        { "type": "textarea", "id": "note", "label": "Why we love it", "default": "Couldn't put it down. The ending stayed with me for weeks." },
        { "type": "text", "id": "staff_name", "label": "Staff name", "default": "Priya, bookseller" }
      ]
    }
  ],
  "presets": [
    { "name": "Staff picks", "category": "Product", "blocks": [{ "type": "pick" }, { "type": "pick", "settings": { "staff_name": "Arjun, manager" } }, { "type": "pick", "settings": { "staff_name": "Meera, children's books" } }] }
  ]
}
{% endschema %}
