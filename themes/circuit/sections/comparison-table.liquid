{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) { .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
{%- endstyle -%}
{%- assign compared = section.settings.products -%}
<div class="comparison scheme-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="section-heading section-heading--left" data-reveal>
      <div>
        {%- if section.settings.caption != blank -%}<p class="eyebrow">{{ section.settings.caption | escape }}</p>{%- endif -%}
        <h2 class="section-heading__title h1">{{ section.settings.heading | escape }}</h2>
      </div>
    </div>
    <div class="comparison__scroll">
      <table class="comparison__table">
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">Feature</span></th>
            {%- if compared.size > 0 -%}
              {%- for item in compared limit: 4 -%}
                <th scope="col">
                  <a class="comparison__product" href="{{ item.url }}">
                    {%- if item.featured_image -%}{{ item.featured_image | image_url: width: 320 | image_tag: loading: 'lazy', alt: item.title }}{%- endif -%}
                    <span>{{ item.title | escape }}</span>
                  </a>
                </th>
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..3) -%}<th scope="col"><span class="comparison__product">{{ 'product-3' | placeholder_svg_tag }}<span>Product {{ i }}</span></span></th>{%- endfor -%}
            {%- endif -%}
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Price</th>
            {%- if compared.size > 0 -%}{%- for item in compared limit: 4 -%}<td>{% render 'price', product: item %}</td>{%- endfor -%}{%- else -%}{%- for i in (1..3) -%}<td>{{ 2999 | times: i | money }}</td>{%- endfor -%}{%- endif -%}
          </tr>
          {%- if section.settings.show_rating -%}
            <tr>
              <th scope="row">Rating</th>
              {%- for item in compared limit: 4 -%}<td>{% render 'rating', rating: item.rating, count: item.review_count %}{% if item.rating == 0 %}—{% endif %}</td>{%- endfor -%}
            </tr>
          {%- endif -%}
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.label | escape }}</th>
              {%- assign values = block.settings.values | split: '|' -%}
              {%- assign columns = 3 -%}{%- if compared.size > 0 -%}{%- assign columns = compared.size | at_most: 4 -%}{%- endif -%}
              {%- for i in (1..columns) -%}
                {%- assign value = values[forloop.index0] | strip -%}
                <td>
                  {%- if value == 'yes' -%}{% render 'icon', name: 'check', size: 18, class: 'comparison__yes' %}
                  {%- elsif value == 'no' or value == blank -%}<span class="comparison__no">—</span>
                  {%- else -%}{{ value | escape }}{%- endif -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
          <tr class="comparison__actions">
            <th scope="row"><span class="visually-hidden">Buy</span></th>
            {%- for item in compared limit: 4 -%}<td><a class="button button--small" href="{{ item.url }}">{{ 'products.product.view_full_details' | t }}</a></td>{%- endfor -%}
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Comparison table",
  "tag": "section",
  "class": "section section-comparison",
  "max_blocks": 12,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "caption", "label": "Caption", "default": "Compare" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the right one for you" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 4 },
    { "type": "checkbox", "id": "show_rating", "label": "Show ratings", "default": true },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "background", "label": "Background" },
        { "value": "surface", "label": "Surface" },
        { "value": "surface-alt", "label": "Surface alternate" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "surface"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "label", "label": "Feature", "default": "Battery life" },
        { "type": "text", "id": "values", "label": "Values", "info": "One per product, in order, separated by |. Use \"yes\" or \"no\" for a tick or a dash.", "default": "20 h | 30 h | 40 h" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison table",
      "category": "Product",
      "blocks": [
        { "type": "row", "settings": { "label": "Battery life", "values": "20 h | 30 h | 40 h" } },
        { "type": "row", "settings": { "label": "Noise cancelling", "values": "no | yes | yes" } },
        { "type": "row", "settings": { "label": "Warranty", "values": "1 year | 1 year | 2 years" } }
      ]
    }
  ]
}
{% endschema %}
