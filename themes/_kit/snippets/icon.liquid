{%- comment -%}
  Inline icons. Usage: {% render 'icon', name: 'cart' %}
{%- endcomment -%}
{%- capture attrs -%}class="icon icon-{{ name }}{% if class %} {{ class }}{% endif %}" aria-hidden="true" focusable="false" width="{{ size | default: 20 }}" height="{{ size | default: 20 }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke | default: 1.6 }}" stroke-linecap="round" stroke-linejoin="round"{%- endcapture -%}
{%- case name -%}
  {%- when 'cart' -%}<svg {{ attrs }}><path d="M5 7h14l-1.2 11.1a2 2 0 0 1-2 1.9H8.2a2 2 0 0 1-2-1.9L5 7Z"/><path d="M9 7V6a3 3 0 0 1 6 0v1"/></svg>
  {%- when 'search' -%}<svg {{ attrs }}><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg>
  {%- when 'account' -%}<svg {{ attrs }}><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
  {%- when 'menu' -%}<svg {{ attrs }}><path d="M3 6h18M3 12h18M3 18h18"/></svg>
  {%- when 'close' -%}<svg {{ attrs }}><path d="M6 6l12 12M18 6 6 18"/></svg>
  {%- when 'chevron-down' -%}<svg {{ attrs }}><path d="m6 9 6 6 6-6"/></svg>
  {%- when 'chevron-right' -%}<svg {{ attrs }}><path d="m9 6 6 6-6 6"/></svg>
  {%- when 'chevron-left' -%}<svg {{ attrs }}><path d="m15 6-6 6 6 6"/></svg>
  {%- when 'arrow-right' -%}<svg {{ attrs }}><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  {%- when 'plus' -%}<svg {{ attrs }}><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'minus' -%}<svg {{ attrs }}><path d="M5 12h14"/></svg>
  {%- when 'trash' -%}<svg {{ attrs }}><path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3"/></svg>
  {%- when 'check' -%}<svg {{ attrs }}><path d="m5 12 5 5 9-10"/></svg>
  {%- when 'star' -%}<svg {{ attrs }} fill="currentColor" stroke="none"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z"/></svg>
  {%- when 'truck' -%}<svg {{ attrs }}><path d="M3 6h11v10H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="1.8"/><circle cx="17.5" cy="18" r="1.8"/></svg>
  {%- when 'return' -%}<svg {{ attrs }}><path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-4"/></svg>
  {%- when 'lock' -%}<svg {{ attrs }}><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
  {%- when 'leaf' -%}<svg {{ attrs }}><path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14"/><path d="M5 19 14 10"/></svg>
  {%- when 'heart' -%}<svg {{ attrs }}><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z"/></svg>
  {%- when 'gift' -%}<svg {{ attrs }}><rect x="4" y="9" width="16" height="11" rx="1"/><path d="M4 13h16M12 9v11M12 9S10.5 4 8 5s-.5 4 4 4Zm0 0s1.5-5 4-4 .5 4-4 4Z"/></svg>
  {%- when 'shield' -%}<svg {{ attrs }}><path d="M12 3 5 6v6c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg>
  {%- when 'sparkle' -%}<svg {{ attrs }}><path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"/></svg>
  {%- when 'chat' -%}<svg {{ attrs }}><path d="M5 18V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H9l-4 4Z"/></svg>
  {%- when 'clock' -%}<svg {{ attrs }}><circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3 2"/></svg>
  {%- when 'globe' -%}<svg {{ attrs }}><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.5 2.6 3.5 5.4 3.5 8.5s-1 5.9-3.5 8.5c-2.5-2.6-3.5-5.4-3.5-8.5s1-5.9 3.5-8.5Z"/></svg>
  {%- when 'box' -%}<svg {{ attrs }}><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="m4 7.5 8 4.5 8-4.5M12 12v9"/></svg>
  {%- when 'share' -%}<svg {{ attrs }}><circle cx="18" cy="5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="m8.2 10.8 7.6-4.4M8.2 13.2l7.6 4.4"/></svg>
  {%- when 'play' -%}<svg {{ attrs }} fill="currentColor" stroke="none"><path d="M8 5v14l11-7L8 5Z"/></svg>
  {%- when 'filter' -%}<svg {{ attrs }}><path d="M4 6h16M7 12h10M10 18h4"/></svg>
  {%- when 'instagram' -%}<svg {{ attrs }}><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r=".8" fill="currentColor"/></svg>
  {%- when 'facebook' -%}<svg {{ attrs }}><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H8v4h2v7h4v-7h3l1-4h-4V8Z"/></svg>
  {%- when 'x' -%}<svg {{ attrs }}><path d="M4 4l16 16M20 4 4 20"/></svg>
  {%- when 'youtube' -%}<svg {{ attrs }}><rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="m10 9 5 3-5 3V9Z" fill="currentColor"/></svg>
  {%- when 'tiktok' -%}<svg {{ attrs }}><path d="M14 4v10.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 4c.5 2.5 2.3 4 5 4"/></svg>
  {%- when 'pinterest' -%}<svg {{ attrs }}><circle cx="12" cy="12" r="8.5"/><path d="M11 8.5c3-1 5 .5 5 3 0 2.5-1.8 4-3.6 3.5-1-.3-1.4-1.2-1.4-1.2L10 20"/></svg>
  {%- when 'whatsapp' -%}<svg {{ attrs }}><path d="M4 20l1.3-4A8 8 0 1 1 8 18.7L4 20Z"/></svg>
  {%- when 'linkedin' -%}<svg {{ attrs }}><rect x="3.5" y="3.5" width="17" height="17" rx="2"/><path d="M8 10v6M8 7.5v.1M12 16v-3.5a2 2 0 0 1 4 0V16M12 10v6"/></svg>
  {%- else -%}<svg {{ attrs }}><circle cx="12" cy="12" r="3"/></svg>
{%- endcase -%}
