{%- comment -%}
  An address form for the address book.
  Accepts: address (an address, or customer.new_address), legend (a locale key), submit (a locale key), id_prefix
{%- endcomment -%}
{%- form 'customer_address', address, class: 'customer__form address-form' -%}
  {%- if form.errors -%}
    <div class="form__message form__message--error" role="alert">{{ form.errors | default_errors }}</div>
    <script>(document.currentScript.closest('details') || {}).open = true;</script>
  {%- endif -%}
  <fieldset>
    <legend class="visually-hidden">{{ legend | t }}</legend>
    <div class="customer__row">
      <div class="field">
        <label class="field__label" for="AddressFirstName-{{ id_prefix }}">{{ 'customer.addresses.first_name' | t }}</label>
        <input class="field__input" id="AddressFirstName-{{ id_prefix }}" name="address[first_name]" value="{{ form.first_name | escape }}" autocomplete="given-name" required>
      </div>
      <div class="field">
        <label class="field__label" for="AddressLastName-{{ id_prefix }}">{{ 'customer.addresses.last_name' | t }}</label>
        <input class="field__input" id="AddressLastName-{{ id_prefix }}" name="address[last_name]" value="{{ form.last_name | escape }}" autocomplete="family-name">
      </div>
    </div>
    <div class="field">
      <label class="field__label" for="AddressAddress1-{{ id_prefix }}">{{ 'customer.addresses.address1' | t }}</label>
      <input class="field__input" id="AddressAddress1-{{ id_prefix }}" name="address[address1]" value="{{ form.address1 | escape }}" autocomplete="address-line1" required>
    </div>
    <div class="field">
      <label class="field__label" for="AddressAddress2-{{ id_prefix }}">{{ 'customer.addresses.address2' | t }}</label>
      <input class="field__input" id="AddressAddress2-{{ id_prefix }}" name="address[address2]" value="{{ form.address2 | escape }}" autocomplete="address-line2">
    </div>
    <div class="customer__row">
      <div class="field">
        <label class="field__label" for="AddressCity-{{ id_prefix }}">{{ 'customer.addresses.city' | t }}</label>
        <input class="field__input" id="AddressCity-{{ id_prefix }}" name="address[city]" value="{{ form.city | escape }}" autocomplete="address-level2" required>
      </div>
      <div class="field">
        <label class="field__label" for="AddressProvince-{{ id_prefix }}">{{ 'customer.addresses.province' | t }}</label>
        <input class="field__input" id="AddressProvince-{{ id_prefix }}" name="address[province]" value="{{ form.province | escape }}" autocomplete="address-level1" required>
      </div>
    </div>
    <div class="customer__row">
      <div class="field">
        <label class="field__label" for="AddressCountry-{{ id_prefix }}">{{ 'customer.addresses.country' | t }}</label>
        {%- assign chosen = form.country_code | default: localization.country.iso_code -%}
        <select class="select__select" id="AddressCountry-{{ id_prefix }}" name="address[country]" autocomplete="country">
          {%- for country in localization.available_countries -%}
            <option value="{{ country.iso_code }}"{% if country.iso_code == chosen %} selected{% endif %}>{{ country.name }}</option>
          {%- endfor -%}
        </select>
      </div>
      <div class="field">
        <label class="field__label" for="AddressZip-{{ id_prefix }}">{{ 'customer.addresses.zip' | t }}</label>
        <input class="field__input" id="AddressZip-{{ id_prefix }}" name="address[zip]" value="{{ form.zip | escape }}" autocomplete="postal-code" required>
      </div>
    </div>
    <div class="field">
      <label class="field__label" for="AddressPhone-{{ id_prefix }}">{{ 'customer.addresses.phone' | t }}</label>
      <input class="field__input" type="tel" id="AddressPhone-{{ id_prefix }}" name="address[phone]" value="{{ form.phone | escape }}" autocomplete="tel">
    </div>
    <label class="customer__choice customer__choice--block">
      <input type="checkbox" name="address[default]" value="1"{% if form.default %} checked{% endif %}> {{ 'customer.addresses.set_default' | t }}
    </label>
    <button type="submit" class="button button--small">{{ submit | t }}</button>
  </fieldset>
{%- endform -%}
