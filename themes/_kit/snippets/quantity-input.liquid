{%- comment -%} Accepts: name, value, id, label, min, max, line (cart line index), form (the form it belongs to) {%- endcomment -%}
<quantity-input class="quantity" data-quantity>
  <button class="quantity__button" type="button" name="minus" data-quantity-step="-1" aria-label="{{ 'products.product.quantity.decrease' | t }}">{% render 'icon', name: 'minus', size: 16 %}</button>
  <input class="quantity__input" type="number" name="{{ name | default: 'quantity' }}" id="{{ id }}" value="{{ value | default: 1 }}" min="{{ min | default: 1 }}"{% if max %} max="{{ max }}"{% endif %} step="1" aria-label="{% if label %}{{ label | escape }}{% else %}{{ 'products.product.quantity.label' | t }}{% endif %}"{% if line %} data-line="{{ line }}"{% endif %}{% if form %} form="{{ form }}"{% endif %}>
  <button class="quantity__button" type="button" name="plus" data-quantity-step="1" aria-label="{{ 'products.product.quantity.increase' | t }}">{% render 'icon', name: 'plus', size: 16 %}</button>
</quantity-input>
