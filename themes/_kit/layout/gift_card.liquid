<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% if localization.language.rtl %}rtl{% else %}ltr{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {%- comment -%} A gift card's page shows its code: never indexed, never sent on as a referrer. {%- endcomment -%}
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <title>{{ 'gift_cards.issued.title_tag' | t: shop: shop.name }}</title>
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'theme-style.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-gift-card">
    <main id="MainContent" class="gift-card-main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
