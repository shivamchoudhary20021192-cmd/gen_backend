{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) { .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
{%- endstyle -%}
<div class="customer customer--addresses scheme-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width page-width--narrow">
    <a class="link--back" href="{{ routes.account_url }}">{% render 'icon', name: 'chevron-left', size: 16 %} {{ 'customer.account.return' | t }}</a>
    <h1 class="customer__title">{{ 'customer.addresses.title' | t }}</h1>

    {%- form 'customer_address', customer.new_address -%}
      {%- if form.posted_successfully -%}
        <p class="form__message form__message--success" role="status">{% render 'icon', name: 'check', size: 18 %} {{ 'customer.addresses.saved' | t }}</p>
      {%- endif -%}
    {%- endform -%}

    <ul class="address-list" role="list">
      {%- for address in customer.addresses -%}
        <li class="address-card">
          <div class="address-card__body">
            {%- if address.default -%}<span class="badge">{{ 'customer.addresses.default' | t }}</span>{%- endif -%}
            <address class="customer__address">
              <strong>{{ address.name }}</strong><br>
              {{ address.address1 }}{% if address.address2 != blank %}, {{ address.address2 }}{% endif %}<br>
              {{ address.city }}, {{ address.province }} {{ address.zip }}<br>
              {{ address.country }}<br>
              {{ address.phone }}
            </address>
          </div>
          <div class="address-card__actions">
            <details class="address-card__edit">
              <summary class="button button--secondary button--small">{{ 'customer.addresses.edit' | t }}</summary>
              {%- render 'address-form', address: address, legend: 'customer.addresses.edit_address', submit: 'customer.addresses.update', id_prefix: address.id -%}
            </details>
            <form method="post" action="{{ address.url }}" onsubmit="return confirm('{{ 'customer.addresses.delete_confirm' | t | escape }}')">
              <input type="hidden" name="_method" value="delete">
              <button type="submit" class="link">{{ 'customer.addresses.delete' | t }}</button>
            </form>
          </div>
        </li>
      {%- endfor -%}
    </ul>

    <details class="address-new"{% if customer.addresses.size == 0 %} open{% endif %}>
      <summary class="button button--small">{{ 'customer.addresses.add_new' | t }}</summary>
      {%- render 'address-form', address: customer.new_address, legend: 'customer.addresses.add_new', submit: 'customer.addresses.add', id_prefix: 'new' -%}
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Addresses",
  "tag": "section",
  "class": "section section-customer-addresses",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "background", "label": "Background" },
        { "value": "surface", "label": "Surface" },
        { "value": "surface-alt", "label": "Surface alternate" }
      ],
      "default": "background"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ]
}
{% endschema %}
