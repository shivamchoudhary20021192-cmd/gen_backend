{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) { .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
{%- endstyle -%}
{%- assign blog = section.settings.blog | default: blogs.journal -%}
<div class="blog-posts scheme-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="section-heading section-heading--left" data-reveal>
      <h2 class="section-heading__title h1">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.show_view_all and blog -%}<a class="link link--arrow" href="{{ blog.url }}">{{ 'general.view_all' | t }}{% render 'icon', name: 'arrow-right', size: 16 %}</a>{%- endif -%}
    </div>
    <ul class="grid" role="list" style="--columns: {{ section.settings.columns_desktop }}; --columns-mobile: 1;">
      {%- if blog and blog.articles.size > 0 -%}
        {%- for article in blog.articles limit: section.settings.post_limit -%}
          <li class="grid__item" data-reveal>{% render 'card-article', article: article, show_excerpt: section.settings.show_excerpt, show_date: section.settings.show_date %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <li class="grid__item">
            <article class="article-card">
              <div class="article-card__media">{{ 'lifestyle-1' | placeholder_svg_tag: 'article-card__placeholder' }}</div>
              <div class="article-card__info"><h3 class="article-card__title">Your article's title</h3><p class="article-card__excerpt">An overview of the article.</p></div>
            </article>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "class": "section section-blog-posts",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the journal" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "post_limit", "label": "Number of posts to show", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_desktop", "label": "Number of columns on desktop", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true },
    { "type": "checkbox", "id": "show_view_all", "label": "Show \"View all\" link", "default": true },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "background", "label": "Background" },
        { "value": "surface", "label": "Surface" },
        { "value": "surface-alt", "label": "Surface alternate" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "background"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "Blog posts", "category": "Blog" }]
}
{% endschema %}
