{%- assign logo = settings.logo | default: shop.brand.logo -%}
<div class="password scheme-{{ section.settings.color_scheme }}">
  {%- if section.settings.image != blank -%}
    <div class="password__background">{{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', sizes: '100vw', widths: '750, 1100, 1500, 2000, 2400', alt: '' }}</div>
  {%- endif -%}
  <div class="password__inner">
    <div class="password__brand">
      {%- if logo != blank -%}
        {{ logo | image_url: width: 480 | image_tag: class: 'password__logo', alt: shop.name, width: settings.logo_width }}
      {%- else -%}
        <p class="password__wordmark h1">{{ shop.name }}</p>
      {%- endif -%}
    </div>
    <p class="eyebrow">{{ 'general.password_page.opening_soon' | t }}</p>
    <h1 class="password__heading h0">{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.text != blank -%}<div class="password__text rte">{{ section.settings.text }}</div>{%- endif -%}

    {%- if section.settings.show_newsletter -%}
      {%- form 'customer', class: 'newsletter-form password__newsletter' -%}
        <input type="hidden" name="contact[tags]" value="prospect,password page">
        <input type="hidden" name="return_to" value="/password">
        {%- if form.posted_successfully -%}
          <p class="form__message form__message--success">{% render 'icon', name: 'check', size: 16 %} {{ 'general.newsletter.success' | t }}</p>
        {%- else -%}
          <div class="field field--inline field--large">
            <input type="email" name="contact[email]" class="field__input" required autocomplete="email" placeholder="{{ 'general.newsletter.label' | t }}" aria-label="{{ 'general.newsletter.label' | t }}">
            <button type="submit" class="button">{{ 'general.newsletter.button' | t }}</button>
          </div>
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    <details class="password__login"{% if password_failed %} open{% endif %}>
      <summary class="link">{% render 'icon', name: 'lock', size: 14 %} {{ 'general.password_page.login_password_button' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        <label class="visually-hidden" for="Password">{{ 'general.password_page.login_form_password_label' | t }}</label>
        <div class="field field--inline">
          <input type="password" name="password" id="Password" class="field__input" autocomplete="current-password" placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}" required>
          <button type="submit" class="button">{{ 'general.password_page.login_form_submit' | t }}</button>
        </div>
        {%- if form.errors -%}<p class="form__message form__message--error">{{ 'general.password_page.login_form_error' | t }}</p>{%- endif -%}
      {%- endform -%}
    </details>
    {%- render 'social-icons' -%}
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "class": "section section-main-password",
  "enabled_on": { "templates": ["password"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something new is coming" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Be the first to know when we launch.</p>" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email signup", "default": true },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "background", "label": "Background" },
        { "value": "surface", "label": "Surface" },
        { "value": "surface-alt", "label": "Surface alternate" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "surface-alt"
    }
  ]
}
{% endschema %}
