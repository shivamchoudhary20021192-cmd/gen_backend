{%- liquid
  assign overlay = section.settings.image_overlay_opacity | divided_by: 100.0
  assign position = section.settings.desktop_content_position | split: '-'
-%}
<div class="banner banner--{{ section.settings.image_height }}{% if section.settings.image_2 != blank %} banner--split{% endif %}{% if section.settings.show_text_below %} banner--mobile-below{% endif %} scheme-{{ section.settings.color_scheme }}" style="--overlay-opacity: {{ overlay }};">
  <div class="banner__media">
    {%- if section.settings.image != blank -%}
      {%- assign sizes = '100vw' -%}{%- if section.settings.image_2 != blank -%}{%- assign sizes = '50vw' -%}{%- endif -%}
      {%- if section.index == 1 -%}
        {{ section.settings.image | image_url: width: 3000 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: sizes, widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000', class: 'banner__image', alt: section.settings.image.alt }}
      {%- else -%}
        {{ section.settings.image | image_url: width: 3000 | image_tag: sizes: sizes, widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000', class: 'banner__image', alt: section.settings.image.alt }}
      {%- endif -%}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'banner__image placeholder-svg' }}
    {%- endif -%}
    {%- if section.settings.image_2 != blank -%}
      {{ section.settings.image_2 | image_url: width: 1500 | image_tag: sizes: '50vw', widths: '375, 550, 750, 1100, 1500', class: 'banner__image', alt: section.settings.image_2.alt }}
    {%- endif -%}
  </div>
  <div class="banner__content page-width banner__content--{{ position[0] }} banner__content--x-{{ position[1] }}">
    <div class="banner__box{% if section.settings.show_text_box %} banner__box--boxed{% endif %} text-{{ section.settings.desktop_content_alignment }}" data-reveal>
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            {%- if section.index == 1 -%}
              <h1 class="banner__heading {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h1>
            {%- else -%}
              <h2 class="banner__heading {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
          {%- when 'eyebrow' -%}
            <p class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
          {%- when 'text' -%}
            <div class="banner__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'buttons' -%}
            <div class="banner__buttons" {{ block.shopify_attributes }}>
              {%- if block.settings.button_label_1 != blank -%}
                <a {% if block.settings.button_link_1 == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.button_link_1 }}"{% endif %} class="button{% if block.settings.button_style_secondary_1 %} button--secondary{% endif %}">{{ block.settings.button_label_1 | escape }}</a>
              {%- endif -%}
              {%- if block.settings.button_label_2 != blank -%}
                <a {% if block.settings.button_link_2 == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.button_link_2 }}"{% endif %} class="button{% if block.settings.button_style_secondary_2 %} button--secondary{% endif %}">{{ block.settings.button_label_2 | escape }}</a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image banner",
  "tag": "section",
  "class": "section section-image-banner",
  "max_blocks": 4,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "image_2", "label": "Second image", "info": "Shown beside the first on desktop." },
    { "type": "range", "id": "image_overlay_opacity", "label": "Image overlay opacity", "min": 0, "max": 100, "step": 10, "unit": "%", "default": 30 },
    {
      "type": "select",
      "id": "image_height",
      "label": "Banner height",
      "options": [
        { "value": "adapt", "label": "Adapt to first image" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "label": "Desktop content position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "middle-left"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "label": "Desktop content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "checkbox", "id": "show_text_box", "label": "Show container behind text", "default": false },
    { "type": "checkbox", "id": "show_text_below", "label": "Show content below image on mobile", "default": false },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "info": "Text over the image uses the inverse scheme unless a container is shown.",
      "options": [
        { "value": "background", "label": "Background" },
        { "value": "surface", "label": "Surface" },
        { "value": "surface-alt", "label": "Surface alternate" },
        { "value": "accent-surface", "label": "Accent surface" },
        { "value": "inverse", "label": "Inverse" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "inverse"
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "New season" }]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Image banner" },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            { "value": "h2", "label": "Small" },
            { "value": "h1", "label": "Medium" },
            { "value": "h0", "label": "Large" },
            { "value": "hxl", "label": "Extra large" }
          ],
          "default": "h0"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Description", "default": "<p>Give customers details about the banner image(s) or content on the template.</p>" },
        {
          "type": "select",
          "id": "text_style",
          "label": "Text style",
          "options": [
            { "value": "body", "label": "Body" },
            { "value": "subtitle", "label": "Subtitle" }
          ],
          "default": "subtitle"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "button_label_1", "label": "First button label", "default": "Shop now" },
        { "type": "url", "id": "button_link_1", "label": "First button link", "default": "/collections/all" },
        { "type": "checkbox", "id": "button_style_secondary_1", "label": "Use outline style", "default": false },
        { "type": "text", "id": "button_label_2", "label": "Second button label" },
        { "type": "url", "id": "button_link_2", "label": "Second button link" },
        { "type": "checkbox", "id": "button_style_secondary_2", "label": "Use outline style", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image banner",
      "category": "Image",
      "blocks": [{ "type": "heading" }, { "type": "text" }, { "type": "buttons" }]
    }
  ]
}
{% endschema %}
