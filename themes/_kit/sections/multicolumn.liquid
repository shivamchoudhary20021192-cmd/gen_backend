{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) { .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
{%- endstyle -%}
<div class="multicolumn scheme-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <div class="section-heading section-heading--{{ section.settings.heading_alignment }}" data-reveal>
        <h2 class="section-heading__title {{ section.settings.heading_size }}">{{ section.settings.title | escape }}</h2>
      </div>
    {%- endif -%}
    <ul class="grid multicolumn__list multicolumn--{{ section.settings.column_style }} text-{{ section.settings.column_alignment }}" role="list" style="--columns: {{ section.settings.columns_desktop }}; --columns-mobile: {{ section.settings.columns_mobile }};">
      {%- for block in section.blocks -%}
        <li class="grid__item multicolumn__item" {{ block.shopify_attributes }} data-reveal>
          {%- if block.settings.image != blank -%}
            <div class="multicolumn__media multicolumn__media--{{ section.settings.image_width }}">
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw', widths: '240, 360, 540, 800', alt: block.settings.title }}
            </div>
          {%- elsif block.settings.icon != 'none' -%}
            <div class="multicolumn__icon">{% render 'icon', name: block.settings.icon, size: 28 %}</div>
          {%- endif -%}
          {%- if block.settings.title != blank -%}<h3 class="multicolumn__title">{{ block.settings.title | escape }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<div class="multicolumn__text rte">{{ block.settings.text }}</div>{%- endif -%}
          {%- if block.settings.link_label != blank -%}
            <a class="link link--arrow" href="{{ block.settings.link | default: '#' }}">{{ block.settings.link_label | escape }}{% render 'icon', name: 'arrow-right', size: 14 %}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.button_label != blank -%}
      <div class="multicolumn__button text-center"><a class="button" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a></div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Multicolumn",
  "tag": "section",
  "class": "section section-multicolumn",
  "max_blocks": 12,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Multicolumn" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "image_width",
      "label": "Image width",
      "options": [
        { "value": "third", "label": "One-third of column" },
        { "value": "half", "label": "Half of column" },
        { "value": "full", "label": "Full column" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "column_style",
      "label": "Column style",
      "options": [
        { "value": "plain", "label": "Plain" },
        { "value": "card", "label": "Card" }
      ],
      "default": "plain"
    },
    {
      "type": "select",
      "id": "column_alignment",
      "label": "Column alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "columns_desktop", "label": "Number of columns on desktop", "min": 1, "max": 6, "step": 1, "default": 3 },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Number of columns on mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "1"
    },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "background", "label": "Background" },
        { "value": "surface", "label": "Surface" },
        { "value": "surface-alt", "label": "Surface alternate" },
        { "value": "accent-surface", "label": "Accent surface" },
        { "value": "inverse", "label": "Inverse" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "background"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "info": "Shown when there is no image.",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Delivery" },
            { "value": "return", "label": "Returns" },
            { "value": "lock", "label": "Secure payment" },
            { "value": "shield", "label": "Guarantee" },
            { "value": "leaf", "label": "Natural" },
            { "value": "heart", "label": "Care" },
            { "value": "gift", "label": "Gift" },
            { "value": "sparkle", "label": "Quality" },
            { "value": "chat", "label": "Support" },
            { "value": "clock", "label": "Fast" },
            { "value": "globe", "label": "Worldwide" },
            { "value": "box", "label": "Packaging" },
            { "value": "star", "label": "Star" },
            { "value": "check", "label": "Check" }
          ],
          "default": "sparkle"
        },
        { "type": "text", "id": "title", "label": "Heading", "default": "Column" },
        { "type": "richtext", "id": "text", "label": "Description", "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post.</p>" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Multicolumn", "category": "Text", "blocks": [{ "type": "column" }, { "type": "column" }, { "type": "column" }] }
  ]
}
{% endschema %}
