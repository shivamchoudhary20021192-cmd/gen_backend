{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) { .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
{%- endstyle -%}
{%- assign video = section.settings.video_url -%}
<div class="video-section scheme-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="{% if section.settings.full_width %}video-section--full{% else %}page-width{% endif %}">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading section-heading--center"><h2 class="section-heading__title h1">{{ section.settings.heading | escape }}</h2></div>
    {%- endif -%}
    <deferred-media class="video-section__media" data-video-type="{{ video.type }}" data-video-id="{{ video.id }}">
      <button type="button" class="video-section__poster" data-load-media aria-label="{{ section.settings.description | default: 'Play video' | escape }}">
        {%- if section.settings.cover_image != blank -%}
          {{ section.settings.cover_image | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: '100vw', widths: '375, 750, 1100, 1500, 2000', alt: section.settings.description }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        <span class="video-section__play">{% render 'icon', name: 'play', size: 28 %}</span>
      </button>
      <template>
        {%- if video.type == 'youtube' -%}
          <iframe src="https://www.youtube-nocookie.com/embed/{{ video.id }}?autoplay=1&rel=0" title="{{ section.settings.description | escape }}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
        {%- elsif video.type == 'vimeo' -%}
          <iframe src="https://player.vimeo.com/video/{{ video.id }}?autoplay=1" title="{{ section.settings.description | escape }}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
        {%- endif -%}
      </template>
    </deferred-media>
  </div>
</div>

{% schema %}
{
  "name": "Video",
  "tag": "section",
  "class": "section section-video",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "image_picker", "id": "cover_image", "label": "Cover image" },
    { "type": "video_url", "id": "video_url", "accept": ["youtube", "vimeo"], "label": "URL", "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc" },
    { "type": "text", "id": "description", "label": "Video alt text", "default": "Describe the video" },
    { "type": "checkbox", "id": "full_width", "label": "Make section full width", "default": false },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "background", "label": "Background" },
        { "value": "surface", "label": "Surface" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "background"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "Video", "category": "Video" }]
}
{% endschema %}
