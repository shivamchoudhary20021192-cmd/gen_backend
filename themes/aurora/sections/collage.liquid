{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) { .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
{%- endstyle -%}
<div class="collage scheme-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading section-heading--left" data-reveal><h2 class="section-heading__title h1">{{ section.settings.heading | escape }}</h2></div>
    {%- endif -%}
    <div class="collage__grid collage__grid--{{ section.settings.desktop_layout }}">
      {%- for block in section.blocks -%}
        <div class="collage__item collage__item--{{ block.type }}" {{ block.shopify_attributes }} data-reveal>
          {%- case block.type -%}
            {%- when 'image' -%}
              <a class="collage__card" href="{{ block.settings.link | default: '#' }}">
                {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '375, 750, 1100, 1400', alt: block.settings.title }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
                {%- if block.settings.title != blank -%}<span class="collage__label">{{ block.settings.title | escape }}{% render 'icon', name: 'arrow-right', size: 16 %}</span>{%- endif -%}
              </a>
            {%- when 'product' -%}
              {% render 'card-product', card_product: block.settings.product, placeholder_index: forloop.index, show_quick_add: true %}
            {%- when 'collection' -%}
              {% render 'card-collection', card_collection: block.settings.collection, placeholder_index: forloop.index, style: 'overlay', ratio: 'portrait' %}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collage",
  "tag": "section",
  "class": "section section-collage",
  "max_blocks": 3,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New this week" },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop layout",
      "options": [
        { "value": "left", "label": "Large block first" },
        { "value": "right", "label": "Large block last" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "background", "label": "Background" },
        { "value": "surface", "label": "Surface" },
        { "value": "surface-alt", "label": "Surface alternate" }
      ],
      "default": "background"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Label", "default": "Shop the edit" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    { "type": "product", "name": "Product", "settings": [{ "type": "product", "id": "product", "label": "Product" }] },
    { "type": "collection", "name": "Collection", "settings": [{ "type": "collection", "id": "collection", "label": "Collection" }] }
  ],
  "presets": [
    { "name": "Collage", "category": "Image", "blocks": [{ "type": "image" }, { "type": "product" }, { "type": "collection" }] }
  ]
}
{% endschema %}
