{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) { .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
{%- endstyle -%}
<div class="ingredients scheme-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width ingredients__grid">
    <div class="ingredients__media" data-reveal>
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 45vw, 100vw', widths: '375, 750, 1100, 1400', alt: section.settings.heading }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="ingredients__content">
      {%- if section.settings.caption != blank -%}<p class="eyebrow">{{ section.settings.caption | escape }}</p>{%- endif -%}
      <h2 class="h0 ingredients__heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte ingredients__text">{{ section.settings.text }}</div>{%- endif -%}
      <ul class="ingredients__list" role="list">
        {%- for block in section.blocks -%}
          <li class="ingredient" {{ block.shopify_attributes }} data-reveal>
            <span class="ingredient__percent">{% if block.settings.percentage != blank %}{{ block.settings.percentage | escape }}{% else %}{{ forloop.index | prepend: '0' }}{% endif %}</span>
            <div>
              <h3 class="ingredient__name">{{ block.settings.name | escape }}</h3>
              <p class="ingredient__benefit">{{ block.settings.benefit | escape }}</p>
            </div>
          </li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.button_label != blank -%}
        <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Ingredients spotlight",
  "tag": "section",
  "class": "section section-ingredients",
  "max_blocks": 6,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "What's inside" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Clinically proven actives, nothing you don't need" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every formula is built around a few hard-working ingredients, at the concentrations that make a difference.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the range" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "background", "label": "Background" },
        { "value": "surface", "label": "Surface" },
        { "value": "surface-alt", "label": "Surface alternate" },
        { "value": "accent-surface", "label": "Accent surface" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "surface-alt"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Niacinamide" },
        { "type": "text", "id": "percentage", "label": "Concentration", "default": "10%" },
        { "type": "text", "id": "benefit", "label": "Benefit", "default": "Refines pores and evens tone." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients spotlight",
      "category": "Beauty",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "Niacinamide", "percentage": "10%", "benefit": "Refines pores and evens tone." } },
        { "type": "ingredient", "settings": { "name": "Hyaluronic acid", "percentage": "2%", "benefit": "Draws in and holds moisture." } },
        { "type": "ingredient", "settings": { "name": "Ceramides", "percentage": "3%", "benefit": "Repairs the skin barrier." } }
      ]
    }
  ]
}
{% endschema %}
