{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) { .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
{%- endstyle -%}
<div class="routine scheme-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="section-heading section-heading--center" data-reveal>
      {%- if section.settings.caption != blank -%}<p class="eyebrow">{{ section.settings.caption | escape }}</p>{%- endif -%}
      <h2 class="section-heading__title h1">{{ section.settings.heading | escape }}</h2>
    </div>
    <ol class="routine__steps" style="--steps: {{ section.blocks.size | at_least: 1 }};">
      {%- for block in section.blocks -%}
        {%- assign step_product = block.settings.product -%}
        <li class="routine__step" {{ block.shopify_attributes }} data-reveal>
          <span class="routine__number">{{ 'Step' }} {{ forloop.index }}</span>
          <h3 class="routine__title">{{ block.settings.title | escape }}</h3>
          <p class="routine__text">{{ block.settings.text | escape }}</p>
          {%- if step_product != blank -%}
            {% render 'card-product', card_product: step_product, show_quick_add: true %}
          {%- else -%}
            {% render 'card-product', placeholder_index: forloop.index %}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

{% schema %}
{
  "name": "Routine steps",
  "tag": "section",
  "class": "section section-routine",
  "max_blocks": 5,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "caption", "label": "Caption", "default": "Your routine" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three steps to healthy skin" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "background", "label": "Background" },
        { "value": "surface", "label": "Surface" },
        { "value": "surface-alt", "label": "Surface alternate" },
        { "value": "accent-surface", "label": "Accent surface" }
      ],
      "default": "background"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Cleanse" },
        { "type": "text", "id": "text", "label": "Text", "default": "Start with a gentle, low-foam cleanser." },
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Routine steps",
      "category": "Beauty",
      "blocks": [
        { "type": "step", "settings": { "title": "Cleanse", "text": "Start with a gentle, low-foam cleanser." } },
        { "type": "step", "settings": { "title": "Treat", "text": "Target concerns with a concentrated serum." } },
        { "type": "step", "settings": { "title": "Protect", "text": "Seal it in with moisturiser and SPF." } }
      ]
    }
  ]
}
{% endschema %}
