{
  "name": "veylog-admin-api",
  "version": "1.0.0",
  "private": true,
  "description": "Veylog commerce platform API — multi-tenant, Shopify-style: Admin, Storefront and Platform APIs",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-superadmin.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "smoke:commerce": "tsx scripts/smoke-commerce.ts",
    "seed:catalogue": "tsx scripts/seed-catalogue.ts",
    "smoke:fulfilment": "tsx scripts/smoke-fulfilment.ts",
    "smoke:inventory": "tsx scripts/smoke-inventory.ts",
    "smoke:reviews": "tsx scripts/smoke-reviews.ts",
    "smoke:payments": "tsx scripts/smoke-payments.ts",
    "sandbox:payments": "tsx scripts/payments-sandbox.ts",
    "smoke:accounts": "tsx scripts/smoke-accounts.ts",
    "smoke:messaging": "tsx scripts/smoke-messaging.ts",
    "start:worker": "node dist/src/worker.js",
    "worker": "tsx watch src/worker.ts",
    "db:migrate:prod": "node dist/scripts/migrate.js",
    "db:status": "tsx scripts/migrate.ts status",
    "db:bundle": "tsx scripts/build-final-sql.ts",
    "db:fix-timestamps": "tsx scripts/fix-legacy-timestamps.ts",
    "check:tenancy": "tsx scripts/check-tenancy.ts",
    "test": "tsx --test test/unit/*.test.ts",
    "smoke:platform": "tsx scripts/smoke-platform.ts",
    "smoke:catalog": "tsx scripts/smoke-catalog.ts",
    "verify": "npm run typecheck && npm run test && npm run check:sql && npm run check:tenancy && npm run check:themes",
    "check:sql": "tsx scripts/check-sql.ts",
    "check:themes": "tsx scripts/check-themes.ts",
    "theme": "tsx scripts/theme-dev.ts",
    "theme:screenshots": "tsx scripts/theme-screenshots.ts",
    "domains:sweep": "tsx scripts/domains-sweep-once.ts",
    "docs:schema": "tsx scripts/db-schema-doc.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "liquidjs": "^10.29.0",
    "multer": "^2.3.0",
    "mysql2": "^3.11.5",
    "pdfkit": "^0.20.2",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
