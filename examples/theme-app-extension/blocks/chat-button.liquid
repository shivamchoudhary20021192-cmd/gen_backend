{%- comment -%}
  An app embed ("target": "body"): no place on the page of its own. The
  merchant switches it on under Theme settings → App embeds, and it renders
  just before </body> on every page.
{%- endcomment -%}
{%- if block.settings.phone != blank -%}
  {%- assign digits = block.settings.phone | remove: '+' | remove: ' ' | remove: '-' -%}
  <a class="chat-button chat-button--{{ block.settings.position }}" href="https://wa.me/{{ digits }}?text={{ block.settings.message | url_encode }}" target="_blank" rel="noopener" aria-label="{{ block.settings.label | escape }}" style="--chat-bg: {{ block.settings.color }}">
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7a11.4 11.4 0 0 1-4.4-3.9c-.3-.5-1-1.4-1-2.6s.7-1.9.9-2.1c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.3 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.6-.1l1.8.9c.3.1.5.2.5.3.1.2.1.8-.1 1.5Z"/></svg>
    {%- if block.settings.label != blank -%}<span class="chat-button__label">{{ block.settings.label | escape }}</span>{%- endif -%}
  </a>
{%- endif -%}

{% schema %}
{
  "name": "WhatsApp chat button",
  "target": "body",
  "stylesheet": "chat-button.css",
  "settings": [
    { "type": "text", "id": "phone", "label": "WhatsApp number, with country code", "default": "" },
    { "type": "text", "id": "message", "label": "Pre-filled message", "default": "Hi! I have a question about your products." },
    { "type": "text", "id": "label", "label": "Label", "default": "Chat with us" },
    { "type": "color", "id": "color", "label": "Button color", "default": "#25d366" },
    { "type": "select", "id": "position", "label": "Position", "options": [{ "value": "right", "label": "Bottom right" }, { "value": "left", "label": "Bottom left" }], "default": "right" }
  ]
}
{% endschema %}
